<Window x:Class="ec.edu.monster.vista.NuevoPaisDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo país" Width="820" Height="480" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Style="{StaticResource Ventana}">
    <!-- ECUD4 Registrar País, pasos 2 a 6 -->
    <DockPanel Margin="24,20,24,18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Nuevo país" Style="{StaticResource Subtitulo}" Margin="0,0,0,8" />
            <DockPanel>
                <TextBlock Text="Nombre del país" Style="{StaticResource Etiqueta}" VerticalAlignment="Center"
                           DockPanel.Dock="Left" Margin="0,0,8,0" />
                <Button x:Name="BotonConsultar" Content="Consultar" Width="120" Height="36" DockPanel.Dock="Right"
                        Margin="8,0,0,0" Style="{StaticResource BotonSecundario}" IsDefault="True" Click="Consultar_Click" />
                <TextBox x:Name="CampoConsulta" />
            </DockPanel>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <TextBlock x:Name="Mensaje" DockPanel.Dock="Top" Style="{StaticResource LineaMensaje}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ProgressBar x:Name="Progreso" Style="{StaticResource Progreso}" />
                <Button Content="Cancelar" Style="{StaticResource BotonSecundario}" Margin="0,0,8,0" IsCancel="True" Click="Cancelar_Click" />
                <Button x:Name="BotonRegistrar" Content="Registrar" Style="{StaticResource BotonPrimario}"
                        IsEnabled="False" Click="Registrar_Click" />
            </StackPanel>
        </DockPanel>
        <DataGrid x:Name="Tabla" />
    </DockPanel>
</Window>
