<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cliente de consola de APIPaises (TI.2.2). Uso: CONSOLE_APIPAISES_DOTNET_REST.exe [url del servidor] -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CONSOLE_APIPAISES_DOTNET_REST</RootNamespace>
  </PropertyGroup>

  <!-- Las pruebas viven en pruebas/ (exigencia del curso), pero no forman parte del ejecutable. -->
  <ItemGroup>
    <Compile Remove="pruebas\**" />
    <None Remove="pruebas\**" />
    <EmbeddedResource Remove="pruebas\**" />
  </ItemGroup>

  <!-- Dirección del servidor: se edita junto al ejecutable sin recompilar. -->
  <ItemGroup>
    <None Update="cliente.properties" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
