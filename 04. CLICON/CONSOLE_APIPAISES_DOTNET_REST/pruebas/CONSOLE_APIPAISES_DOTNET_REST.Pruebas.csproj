<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pruebas sin dependencias externas: se ejecutan con «dotnet run» sobre la carpeta pruebas. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CONSOLE_APIPAISES_DOTNET_REST.Pruebas</RootNamespace>
  </PropertyGroup>

  <!-- Enlaza el código del cliente (salvo Program.cs). -->
  <ItemGroup>
    <Compile Include="..\Controllers\**\*.cs" LinkBase="App\Controllers" />
    <Compile Include="..\Models\**\*.cs" LinkBase="App\Models" />
    <Compile Include="..\Views\**\*.cs" LinkBase="App\Views" />
  </ItemGroup>

</Project>
